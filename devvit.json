{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "delete-watcher",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "triggers": {
    "onPostSubmit": "/internal/triggers/on-post-submit",
    "onPostDelete": "/internal/triggers/on-post-delete"
  },
  "settings": {
    "subreddit": {
      "detectionWindowHours": {
        "type": "number",
        "label": "Detection window (hours)",
        "helpText": "Flag posts self-deleted by their author within this many hours of posting. Fractional values are allowed (e.g. 0.5 = 30 minutes).",
        "defaultValue": 24,
        "validationEndpoint": "/internal/settings/validate-window"
      },
      "discordWebhookUrl": {
        "type": "string",
        "label": "Discord webhook URL",
        "helpText": "Discord webhook to notify when a self-delete is detected. Leave empty to disable Discord notifications.",
        "defaultValue": "",
        "validationEndpoint": "/internal/settings/validate-webhook"
      },
      "enableDiscord": {
        "type": "boolean",
        "label": "Send Discord notifications",
        "defaultValue": true
      },
      "enableModNote": {
        "type": "boolean",
        "label": "Add a mod note to the author",
        "defaultValue": true
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "permissions": {
    "reddit": true,
    "redis": true,
    "http": {
      "enable": true,
      "domains": ["discord.com", "discordapp.com"]
    }
  },
  "dev": {
    "subreddit": "delete_watcher_dev"
  }
}
